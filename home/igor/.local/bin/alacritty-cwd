#!/usr/bin/env bash
# Open alacritty in the cwd of the focused terminal and, if that terminal has
# a python virtualenv active, re-activate the same one in the new shell.
# The venv is handed over via ALACRITTY_VENV, sourced at the end of ~/.zshrc
# (zshrc resets PATH during startup, so activating any earlier would be undone).

alacritty=/home/igor/.cargo/bin/alacritty
poetry_venvs="$HOME/.cache/pypoetry/virtualenvs"
workon_home="${WORKON_HOME:-$HOME/.virtualenvs}"

# Print a pid and all of its descendants, parents first
descendants() {
    echo "$1"
    local child
    for child in $(pgrep -P "$1" 2>/dev/null); do
        descendants "$child"
    done
}

# Locate the poetry venv for a project dir without invoking poetry (broken
# pyenv shims make `poetry env info` unreliable). Poetry names env dirs
# <sanitized-name>-<base64(sha256(realpath))[:8]>-py<minor>.
poetry_venv_for() {
    local dir=$1 name prefix
    name=$(sed -n 's/^name[[:space:]]*=[[:space:]]*["'\'']\([^"'\'']*\)["'\''].*/\1/p' "$dir/pyproject.toml" | head -1)
    [ -n "$name" ] || return
    prefix=$(/usr/bin/python3 - "$name" "$dir" <<'EOF'
import base64, hashlib, os, re, sys
name, cwd = sys.argv[1], sys.argv[2]
sanitized = re.sub(r'[ $`!*@"\\\r\n\t]', "_", name.lower())[:42]
normalized = os.path.normcase(os.path.realpath(cwd))
h = base64.urlsafe_b64encode(hashlib.sha256(normalized.encode()).digest()).decode()[:8]
print(f"{sanitized}-{h}")
EOF
    ) || return
    ls -td "$poetry_venvs/$prefix"-py* 2>/dev/null | head -1
}

focused_pid=$(niri msg focused-window 2>/dev/null | grep -oP 'PID: \K\d+')
shell_pid=
cwd=
venv=

[[ -n $focused_pid ]] && shell_pid=$(pgrep -P "$focused_pid" 2>/dev/null | head -1)

if [[ -n $shell_pid ]]; then
    cwd=$(readlink -f "/proc/$shell_pid/cwd" 2>/dev/null)

    # A venv activated interactively never shows in the shell's own environ
    # (it's frozen at exec), but every process started after activation
    # carries VIRTUAL_ENV. Deepest match = most recent activation.
    for pid in $(descendants "$shell_pid"); do
        active_venv=$(tr '\0' '\n' 2>/dev/null < "/proc/$pid/environ" |
            sed -n 's/^VIRTUAL_ENV=//p' | head -1)
        [[ -n $active_venv ]] && venv=$active_venv
    done
fi

# Nothing running in the shell to read VIRTUAL_ENV from: infer the venv from
# the cwd instead, walking upwards like ave() does.
if [[ -z $venv && -n $cwd ]]; then
    dir=$cwd
    while [[ $dir != / ]]; do
        if [[ -f $dir/.venv/bin/activate ]]; then
            venv=$dir/.venv
        elif [[ -f $dir/bin/activate ]]; then
            venv=$dir
        elif [[ -f $workon_home/${dir##*/}/bin/activate ]]; then
            venv=$workon_home/${dir##*/}
        elif [[ -f $dir/pyproject.toml ]]; then
            venv=$(poetry_venv_for "$dir")
        fi
        [[ -n $venv ]] && break
        dir=$(dirname "$dir")
    done
fi

args=()
[[ -d $cwd ]] && args+=(--working-directory "$cwd")
[[ -n $venv && -f $venv/bin/activate ]] && export ALACRITTY_VENV=$venv

exec "$alacritty" "${args[@]}"
